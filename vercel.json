{
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"index\"; type=\"application/xml\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/mindos.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    },
    {
      "source": "/orbi.md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/markdown.*"
        }
      ],
      "destination": "/api/home-markdown"
    },
    {
      "source": "/anthem",
      "destination": "/anthem.html"
    },
    {
      "source": "/intel",
      "destination": "/intel.html"
    },
    {
      "source": "/medicare",
      "destination": "/medicare.html"
    },
    {
      "source": "/mindos",
      "destination": "/mindos.html"
    },
    {
      "source": "/mindos.md",
      "destination": "/markdown/mindos.md"
    },
    {
      "source": "/orbi",
      "destination": "/orbi.html"
    },
    {
      "source": "/orbi.md",
      "destination": "/markdown/orbi.md"
    }
  ]
}
